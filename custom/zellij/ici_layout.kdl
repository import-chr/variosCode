layout {
    // Status bar
    default_tab_template {
        pane size=1 borderless=true {
	    plugin location="zellij:compact-bar"
	}
	children
	pane size=1 borderless=true {
            plugin location="zellij:status-bar"
        }
    }

    // Tab 1: System
    tab name="system" {
        pane split_direction="horizontal" {
            pane command="htop" start_suspended=true
            pane command="gping" {
                args "google.com"
                start_suspended true
            }
        }
    }

    // Tab 2: Dev
    tab name="dev" {
        pane cwd="~/Documents/code"
        pane split_direction="vertical" {
            pane {
	        cwd "~/Documents/code"
                command "git"
		args "status"
                start_suspended true
            }
            pane cwd="~/Documents/code"
        }
    }

    // Tab 3: Config
    tab name="config" split_direction="vertical" {
        pane cwd="~/.config/alacritty"
	pane cwd="~/.config/zellij"
        pane cwd="~/.local/bin"
    }
}
